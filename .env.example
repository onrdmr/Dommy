# docker compose bu dosyayı (.env) otomatik okur. Kopyala: cp .env.example .env
# Sadece GEMINI_API_KEY zorunlu — gerisi varsayılanla çalışır.

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL_ID=gemini-2.0-flash
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIM=768

# Dify kurulduktan SONRA doldur (boşsa proxy doğrudan Neo4j+Gemini kullanır):
DIFY_BASE_URL=
DIFY_APP_API_KEY=
DIFY_KB_API_KEY=dommy-kb-dev-key

DOMMY_TOKENS={"pk_live_demo3f9a":{"tenant":"almoso","role":"user"}}
ADMIN_KEY=dommy-admin-dev-key
